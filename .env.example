# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. All three are required in production.
# ---------------------------------------------------------------------------

# Vercel dashboard -> Storage -> Blob -> create store -> copy token.
# If this is missing the app still works: share degrades to the download +
# manual-attach path instead of the OG link preview.
BLOB_READ_WRITE_TOKEN=

# Your deployed origin, no trailing slash. In dev use http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Public base of your blob store. Shown in the Vercel Blob dashboard, looks like
# https://abc123xyz.public.blob.vercel-storage.com
# Used to rebuild the image URL from a share id, which is why there is no database.
NEXT_PUBLIC_BLOB_BASE_URL=
